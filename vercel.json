{
  "buildCommand": "cd artifacts/copyzap && pnpm install --frozen-lockfile && pnpm run build",
  "outputDirectory": "artifacts/copyzap/dist/public",
  "installCommand": "npm i -g pnpm && pnpm install --frozen-lockfile",
  "framework": null,
  "rewrites": [
    {
      "source": "/((?!assets/).*)",
      "destination": "/index.html"
    }
  ]
}
