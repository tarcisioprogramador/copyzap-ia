{
  "installCommand": "npm i -g pnpm@11 && pnpm install --no-frozen-lockfile",
  "buildCommand": "pnpm --filter @workspace/copyzap run build",
  "outputDirectory": "artifacts/copyzap/dist/public",
  "framework": null,
  "rewrites": [
    {
      "source": "/((?!assets/).*)",
      "destination": "/index.html"
    }
  ]
}
