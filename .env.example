# ============================================
# CopyZap AI / ZapCopy AI — Environment Variables
# ============================================
# Copy this file to .env and fill in the values.
# cp .env.example .env

# --- Database ---
# Local PostgreSQL (Docker Compose defaults):
DATABASE_URL=postgresql://copyzap:copyzap_dev@localhost:5432/copyzap

# --- AI Provider ---
# Groq (default — used for copy generation)
GROQ_API_KEY=

# --- JWT Authentication ---
# Generate a strong random string for production
JWT_SECRET=change-this-to-a-secure-random-string-in-production

# --- Server ---
PORT=5000
NODE_ENV=development

# --- Frontend ---
# VITE_API_URL=http://localhost:5000/api

# --- WhatsApp Cloud API (optional) ---
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_VERIFY_TOKEN=copyzap-verify-token
# WHATSAPP_PRODUCT=nossos produtos/serviços
# WHATSAPP_COMPANY=nossa empresa
