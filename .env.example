# ============================================
# CopyZap AI — Environment Variables
# ============================================
# Copy this file to .env and fill in the values.
# cp .env.example .env

# --- Database ---
# Local PostgreSQL (Docker Compose defaults):
DATABASE_URL=postgresql://copyzap:copyzap_dev@localhost:5432/copyzap

# --- AI Provider (choose one) ---
# Groq (default — used for copy generation)
GROQ_API_KEY=

# Anthropic (optional — for batch processing)
ANTHROPIC_API_KEY=

# --- Server ---
PORT=5000
# NODE_ENV=development

# --- Frontend ---
# VITE_API_URL=http://localhost:5000/api
